# Lấy từ https://my.telegram.org
TELEGRAM_API_ID=
TELEGRAM_API_HASH=

# ID nhóm hoặc kênh cần theo dõi (kênh/siêu nhóm thường có prefix -100)
TARGET_CHAT_ID=

# URL Webhook của n8n
N8N_WEBHOOK_URL=https://n8n.your-domain.com/webhook/telegram-to-threads

# Tên file session Telethon (tùy chọn)
SESSION_NAME=session_userbot

# ================================
# ĐIỀU KIỆN LỌC TIN NHẮN (FILTERS)
# ================================
# Bắt buộc phải có ảnh: true hoặc false (mặc định: true)
REQUIRE_PHOTO=true

# Độ dài ký tự caption tối thiểu (0 = không giới hạn)
MIN_LENGTH=0

# Từ khóa BẮT BUỘC có (cách nhau dấu phẩy). Để trống = bắt tất cả tin nhắn
# Ví dụ: #share, #threads, tin hot
INCLUDE_KEYWORDS=

# Từ khóa LOẠI TRỪ (nếu chứa từ khóa này sẽ bỏ qua, cách nhau dấu phẩy)
# Ví dụ: quảng cáo, lừa đảo, cờ bạc
EXCLUDE_KEYWORDS=
