    {
      "parameters": {
        "method": "POST",
        "url": "https://api.openai.com/v1/chat/completions",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpBearerAuth",
        "sendBody": true,
        "bodyParameters": {
          "parameters": [
            {
              "name": "model",
              "value": "gpt-4o-mini"
            },
            {
              "name": "response_format",
              "value": "={{ { type: 'json_object' } }}"
            },
            {
              "name": "messages",
              "value": "={{ [ { role: 'system', content: 'Write 5 COMPLETELY DIFFERENT Threads captions (<380 chars, 2-3 native hashtags) for each account:\\n' + $('Build AI Prompt').item.json.ai_account_rules + '\\nReturn JSON: ' + $('Build AI Prompt').item.json.ai_expected_json }, { role: 'user', content: [ { type: 'text', text: $('Webhook').item.json.body.original_caption || 'Analyze image and generate 5 unique JSON captions.' }, ...($('Webhook').item.json.body.image_base64 ? [{ type: 'image_url', image_url: { url: 'data:image/jpeg;base64,' + $('Webhook').item.json.body.image_base64 } }] : []) ] } ] }}"
            },
            {
              "name": "max_tokens",
              "value": "={{ 1500 }}"
            }
          ]
        },
        "options": {
          "timeout": 30000
        }
      },
      "id": "openai-vision-ready",
      "name": "OpenAI Vision (Standby)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1020,
        680
