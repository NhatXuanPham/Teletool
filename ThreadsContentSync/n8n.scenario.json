      "id": "webhook-trigger",
      "name": "Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        120,
        420
      ],
      "webhookId": "tele-to-threads-trigger"
    },
    {
      "parameters": {
        "jsCode": "const accounts = [\n  {\n    key: 'acc_1',\n    name: 'Account 1',\n    lang: 'Korean (ko-KR)',\n    tone: 'Trendy, casual native Korean Threads user'\n  },\n  {\n    key: 'acc_2',\n    name: 'Account 2',\n    lang: 'Korean (ko-KR)',\n    tone: 'Witty, humorous native Korean netizen, completely different wording from acc_1'\n  },\n  {\n    key: 'acc_3',\n    name: 'Account 3',\n    lang: 'Korean (ko-KR)',\n    tone: 'Short, punchy, curious reaction style in natural Korean'\n  },\n  {\n    key: 'acc_4',\n    name: 'Account 4',\n    lang: 'Traditional Chinese - Taiwan (zh-TW)',\n    tone: 'Natural Taiwanese Threads user (authentic Taiwan phrasing and slang)'\n  },\n  {\n    key: 'acc_5',\n    name: 'Account 5',\n    lang: 'Traditional Chinese - Taiwan (zh-TW)',\n    tone: 'Relatable, engaging Taiwanese netizen, completely different wording from acc_4'\n  }\n];\n\nreturn [{ json: { accounts } }];"
      },
      "id": "account-list",
      "name": "Account List",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        340,
        420
      ]
    },
    {
      "parameters": {
        "jsCode": "const accounts = $input.first().json.accounts || [];\n\nconst accountRules = accounts\n  .map((a, idx) => `${idx + 1}. \"${a.key}\" (${a.name}): Language=${a.lang}, Tone=${a.tone}`)\n  .join('\\n');\n\nconst expectedKeys = accounts.reduce((obj, a) => {\n  obj[a.key] = `Unique ${a.lang} caption`;\n  return obj;\n}, {});\n\nreturn [\n  {\n    json: {\n      accounts,\n      ai_account_rules: accountRules,\n      ai_expected_json: JSON.stringify(expectedKeys)\n    }\n  }\n];"
      },
      "id": "build-ai-prompt",
      "name": "Build AI Prompt",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        560,
        420
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://freeimage.host/api/1/upload",
        "sendBody": true,
        "contentType": "form-urlencoded",
        "bodyParameters": {
          "parameters": [
            {
              "name": "key",
              "value": "6d207e02198a847aa98d0a2a901485a5"
            },
            {
              "name": "action",
              "value": "upload"
            },
            {
              "name": "source",
              "value": "={{ $('Webhook').item.json.body.image_base64 }}"
