    {
      "parameters": {
        "jsCode": "const rawAiText =\n  $input.first().json.candidates?.[0]?.content?.parts?.[0]?.text ||\n  $input.first().json.choices?.[0]?.message?.content ||\n  '{}';\n\nlet parsed = {};\ntry {\n  parsed = JSON.parse(rawAiText.replace(/```json|```/g, '').trim());\n} catch (e) {\n  parsed = {};\n}\n\nconst imageUrl = $('Upload Image').first().json.image?.url || '';\nconst fallback = $('Webhook').first().json.body.original_caption || '';\nconst accounts = $('Account List').first().json.accounts || [];\n\nreturn accounts.map((acc) => ({\n  json: {\n    account_key: acc.key,\n    account_name: acc.name,\n    lang: acc.lang,\n    media_type: imageUrl ? 'IMAGE' : 'TEXT',\n    image_url: imageUrl,\n    caption: (parsed[acc.key] || fallback).trim().slice(0, 495)\n  }\n}));"
      },
