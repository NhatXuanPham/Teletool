    {
      "parameters": {
        "method": "POST",
        "url": "https://generativelanguage.googleapis.com/v1beta/models/gemini-3.5-flash-lite:generateContent",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpQueryAuth",
        "sendBody": true,
        "bodyParameters": {
          "parameters": [
            {
              "name": "system_instruction",
              "value": "={{ { parts: [{ text: 'Read all details and text in the image. Write 5 COMPLETELY DIFFERENT, unique Threads captions (<380 chars each, with 2-3 native hashtags) so no two accounts sound alike:\\n' + $('Build AI Prompt').item.json.ai_account_rules + '\\nReturn pure JSON matching: ' + $('Build AI Prompt').item.json.ai_expected_json }] } }}"
            },
            {
              "name": "contents",
              "value": "={{ [{ parts: [ { text: $('Webhook').item.json.body.original_caption ? 'Original caption: ' + $('Webhook').item.json.body.original_caption : 'Analyze this image and generate 5 unique JSON captions.' }, ...($('Webhook').item.json.body.image_base64 ? [{ inline_data: { mime_type: 'image/jpeg', data: $('Webhook').item.json.body.image_base64 } }] : []) ] }] }}"
            },
            {
              "name": "generationConfig",
              "value": "={{ { maxOutputTokens: 1500, temperature: 0.8, responseMimeType: 'application/json' } }}"
            }
          ]
        },
        "options": {
          "timeout": 30000
        }
      },
      "id": "gemini-ai-active",
      "name": "Gemini AI",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1020,
        420
      ]
